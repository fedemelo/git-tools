#!/usr/bin/env bash
set -euo pipefail

usage="usage: git land [title] [--until <commit>] [--each] [--force]"

force=0
each=0
until_ref=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --force) force=1; shift ;;
    --each) each=1; shift ;;
    --until)
      [ $# -ge 2 ] || { echo "git-land: --until needs a commit" >&2; exit 1; }
      until_ref="$2"; shift 2 ;;
    --until=*) until_ref="${1#*=}"; shift ;;
    -h|--help) echo "$usage"; exit 0 ;;
    -*) echo "git-land: unknown flag '$1'" >&2; echo "$usage" >&2; exit 1 ;;
    *) args+=("$1"); shift ;;
  esac
done
title="${args[0]:-}"

if [ "$each" -eq 1 ] && [ -n "$title" ]; then
  echo "git-land: --each takes each PR's title from its own commit, so a title argument would be ambiguous" >&2
  exit 1
fi

branch="$(git symbolic-ref --short HEAD)" || {
  echo "git-land: not on a branch (detached HEAD)" >&2
  exit 1
}

upstream="$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null)" || {
  echo "git-land: '$branch' has no upstream tracking branch" >&2
  exit 1
}

remote="${upstream%%/*}"

remote_url="$(git remote get-url "$remote")"
repo_owner="$(gh repo view "$remote_url" --json owner -q .owner.login)"
viewer_login="$(gh api user -q .login)"

if [ "$repo_owner" != "$viewer_login" ] && [ "$force" -ne 1 ]; then
  echo "git-land: '$remote' ($repo_owner/...) isn't owned by you ($viewer_login) — refusing to auto-merge without review on someone else's repo." >&2
  echo "git-land: pass --force if you're sure this is still solo/unreviewed work." >&2
  exit 1
fi

git fetch "$remote" "$branch"

read -r behind _ < <(git rev-list --left-right --count "@{u}...HEAD")

if [ "$behind" -gt 0 ]; then
  echo "git-land: '$branch' is $behind commit(s) behind '$upstream' — pull/rebase first" >&2
  exit 1
fi

# Only a commit reachable from HEAD can be landed: git history is a chain, so what
# gets pushed is always the range upstream..<tip>, never an arbitrary subset of it.
if [ -n "$until_ref" ]; then
  tip="$(git rev-parse --verify --quiet "${until_ref}^{commit}")" || {
    echo "git-land: '$until_ref' is not a commit" >&2
    exit 1
  }
  git merge-base --is-ancestor "$tip" HEAD || {
    echo "git-land: '$until_ref' is not an ancestor of HEAD — only commits on '$branch' can be landed" >&2
    exit 1
  }
  git merge-base --is-ancestor "@{u}" "$tip" || {
    echo "git-land: '$until_ref' is not ahead of '$upstream' — nothing there to land" >&2
    exit 1
  }
else
  tip="$(git rev-parse HEAD)"
fi

ahead="$(git rev-list --count "@{u}..$tip")"

if [ "$ahead" -eq 0 ]; then
  if [ -n "$until_ref" ]; then
    echo "git-land: nothing to land up to '$until_ref' — it is already on '$upstream'" >&2
  else
    echo "git-land: nothing to land, '$branch' is up to date with '$upstream'" >&2
  fi
  exit 1
fi

pending_tmp=""
cleanup() {
  if [ -n "$pending_tmp" ]; then
    echo "git-land: leaving $remote/$pending_tmp pushed for manual recovery" >&2
  fi
}
trap cleanup EXIT

land_one() {
  local land_tip="$1" land_title="$2"
  local count body tmp pr_url

  count="$(git rev-list --count "@{u}..$land_tip")"
  [ -n "$land_title" ] || land_title="$(git log -1 --format=%s "$land_tip")"
  body="$(git log --format='- %s' "@{u}..$land_tip")"
  tmp="tmp/${branch}-$(git rev-parse --short "$land_tip")"

  echo "git-land: pushing $count commit(s) to $remote/$tmp"
  git push "$remote" "$land_tip:refs/heads/$tmp"
  pending_tmp="$tmp"

  pr_url="$(gh pr create --base "$branch" --head "$tmp" --title "$land_title" --body "$body" --assignee @me)"
  echo "git-land: opened $pr_url"

  gh pr comment "$pr_url" --body "PR automatically created and merged without review for recordkeeping."

  # Push the exact local (already-signed) commits straight onto the base branch.
  # behind==0 was already confirmed, so this is a plain fast-forward — no server-side
  # rebase involved, unlike `gh pr merge --rebase`, which would recreate the commits via
  # GitHub's API and strip GPG signatures / rewrite the committer to the GitHub account email.
  if git push "$remote" "$land_tip:refs/heads/$branch"; then
    pending_tmp=""
    echo "git-land: pushed directly to $remote/$branch (signatures preserved); PR will auto-close as merged"
    git push "$remote" --delete "$tmp" || echo "git-land: could not delete $remote/$tmp, leaving it" >&2
    return 0
  fi

  echo "git-land: direct push rejected (branch protection?) — falling back to API rebase-merge" >&2
  echo "git-land: warning — this path recreates commits via GitHub's API, losing GPG signatures and rewriting the committer email" >&2

  if ! gh pr merge "$pr_url" --rebase --delete-branch; then
    echo "git-land: immediate merge blocked (checks/review required), scheduling auto-merge"
    if gh pr merge "$pr_url" --rebase --auto --delete-branch; then
      pending_tmp=""
      echo "git-land: auto-merge enabled. It will land once checks pass — local '$branch' not yet synced."
      echo "git-land: run 'git pull --rebase' once it's merged."
      return 0
    fi
    echo "git-land: could not enable auto-merge either — PR left open at $pr_url" >&2
    exit 1
  fi

  pending_tmp=""
  echo "git-land: merged immediately"

  git fetch "$remote" "$branch"

  if ! git diff --quiet "$land_tip" "$remote/$branch"; then
    echo "git-land: warning — $remote/$branch diverged from expected content (concurrent push?)." >&2
    echo "git-land: not touching local '$branch'. Run 'git pull --rebase' to reconcile." >&2
    return 0
  fi

  # This path rewrote the landed commits server-side, so anything still sitting on top of
  # them locally is now based on commits that no longer exist upstream and has to be replayed.
  if [ "$land_tip" = "$(git rev-parse HEAD)" ]; then
    git update-ref "refs/heads/$branch" "$remote/$branch"
    echo "git-land: local '$branch' synced to $remote/$branch"
  elif git rebase --onto "$remote/$branch" "$land_tip" "$branch"; then
    echo "git-land: replayed the still-unlanded commit(s) onto $remote/$branch"
  else
    echo "git-land: rebase of the still-unlanded commit(s) onto $remote/$branch hit a conflict." >&2
    echo "git-land: resolve it and run 'git rebase --continue' before landing anything else." >&2
    exit 1
  fi
}

if [ "$each" -eq 1 ]; then
  echo "git-land: landing $ahead commit(s) as $ahead separate PR(s)"
  # Selected by position rather than by a precomputed list of hashes: the rebase fallback
  # rewrites the commits still waiting, which would invalidate any hash captured up front.
  for _ in $(seq 1 "$ahead"); do
    next="$(git rev-list --reverse "@{u}..HEAD" | sed -n 1p)"
    [ -n "$next" ] || break
    land_one "$next" ""
  done
else
  land_one "$tip" "$title"
fi

remaining="$(git rev-list --count "@{u}..HEAD")"
if [ "$remaining" -gt 0 ]; then
  echo "git-land: $remaining commit(s) still ahead of '$upstream' and not landed"
fi
